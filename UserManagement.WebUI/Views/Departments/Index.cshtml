@model List<UserManagement.WebUI.ViewModels.DepartmentVM>

@{
    ViewData["Title"] = "Index";
}

<h1>Departments</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Department Id</th>
            <th>Department Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DepartmentId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DepartmentName)
            </td>
            <td class="action-buttons">
                    <a asp-controller="Departments" asp-action="Details" asp-route-Id="@item.DepartmentId" class="btn btn-info view-button"><i class='bx bx-detail'></i>Detail</a> |
                    <a asp-controller="Departments" asp-action="Edit" asp-route-Id="@item.DepartmentId" class="btn btn-primary edit-button"><i class='bx bx-edit'></i>Edit</a> |
                    <a asp-controller="Departments" asp-action="Delete" asp-route-Id="@item.DepartmentId" class="btn btn-danger delete-button"><i class='bx bx-trash'></i>Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
